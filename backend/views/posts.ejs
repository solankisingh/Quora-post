<%- include("includes/head.ejs") %>
<body>
    <%- include("includes/header.ejs") %>
    <main class="main-post">
        <button id="createBtn"><a href="/posts/new">Create New Post</a></button>
        <% for(let data of DB){ %>
            <div class="post">
                <h4><span>@</span> <%= data.user %></h4>
                <p>
                    <%= data.content %>
                </p>
                <br>
                <button><a href="/posts/<%=data.id %>">Show</a></button>
            </div>
            <hr>
        <% } %>
    </main>
    <%- include("includes/footer.ejs") %>
</body>
</html>